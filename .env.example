# Required. JWT signing key — the app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your_jwt_secret_here

# Required. Postgres connection string.
# Local:  postgresql://localhost/rentscout
# Docker: set automatically by docker-compose.yml
DATABASE_URL=postgresql://localhost/rentscout

# Optional. Only the /chat endpoint uses it; the rest of the app runs without.
OPENAI_API_KEY=your_openai_api_key_here

# Comma-separated origins allowed to call the API.
# Add the deployed frontend URL here after deploying.
ALLOWED_ORIGINS=http://localhost:3000
